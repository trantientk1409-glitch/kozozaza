<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<section id="CCL-{{ section.id }}" class="ccl-section">
  <div class="ccl-page page-width">
    {% if section.settings.heading != blank %}
      <h2 class="ccl-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="ccl-desktop">
      {% for block in section.blocks limit: 4 %}
        {% assign collection = block.settings.collection %}
        <a class="ccl-card" href="{{ collection.url | default: block.settings.link }}" {{ block.shopify_attributes }}>
          <div class="ccl-image-box">
            {% if block.settings.desktop_image != blank %}
              {{ block.settings.desktop_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'ccl-img' }}
            {% elsif collection.image != blank %}
              {{ collection.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'ccl-img' }}
            {% endif %}

            <div class="ccl-title">
              {{ block.settings.title | default: collection.title }}
            </div>
          </div>
        </a>
      {% endfor %}
    </div>

    <div class="ccl-mobile swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks limit: 6 %}
          {% assign collection = block.settings.collection %}
          <div class="swiper-slide ccl-slide" {{ block.shopify_attributes }}>
            <a class="ccl-card" href="{{ collection.url | default: block.settings.link }}">
              <div class="ccl-image-box">
                {% if block.settings.mobile_image != blank %}
                  {{ block.settings.mobile_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'ccl-img' }}
                {% elsif block.settings.desktop_image != blank %}
                  {{ block.settings.desktop_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'ccl-img' }}
                {% elsif collection.image != blank %}
                  {{ collection.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'ccl-img' }}
                {% endif %}
              </div>

              <div class="ccl-title ccl-mobile-title">
                {{ block.settings.mobile_title | default: block.settings.title | default: collection.title }}
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    </div>

    <button class="ccl-arrow ccl-prev" type="button" aria-label="Previous"></button>
    <button class="ccl-arrow ccl-next" type="button" aria-label="Next"></button>
  </div>
</section>

<style>
  #CCL-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #CCL-{{ section.id }} .ccl-heading {
    margin: 0 0 24px;
    text-align: center;
  }

  #CCL-{{ section.id }} .ccl-desktop {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: {{ section.settings.desktop_gap }}px;
  }

  #CCL-{{ section.id }} .ccl-mobile,
  #CCL-{{ section.id }} .ccl-arrow {
    display: none;
  }

  #CCL-{{ section.id }} .ccl-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  #CCL-{{ section.id }} .ccl-image-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.desktop_ratio }};
    overflow: hidden;
    background: {{ section.settings.card_background }};
  }

  #CCL-{{ section.id }} .ccl-img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: {{ section.settings.image_fit }};
    transition: transform 0.35s ease;
  }

  #CCL-{{ section.id }} .ccl-title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 8px 6px;
    text-align: center;
    font-size: {{ section.settings.desktop_title_size }}px;
    line-height: 1.2;
    color: {{ section.settings.title_color }};
    font-weight: {{ section.settings.title_weight }};
    z-index: 2;
    font-family: {{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }};
letter-spacing: {{ section.settings.title_letter_spacing }}px;
text-transform: {{ section.settings.title_transform }};
  }

  @media screen and (min-width: 750px) {
    #CCL-{{ section.id }} .ccl-page {
      max-width: none !important;
      width: 100% !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
    }

    #CCL-{{ section.id }} .ccl-card {
      transition: transform 0.28s ease, box-shadow 0.28s ease;
    }

    #CCL-{{ section.id }} .ccl-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
    }

    #CCL-{{ section.id }} .ccl-card:hover .ccl-img {
      transform: scale(1.03);
    }
  }

  @media screen and (max-width: 749px) {
    #CCL-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #CCL-{{ section.id }} .ccl-desktop {
      display: none !important;
    }

    #CCL-{{ section.id }} .ccl-page {
      position: relative;
      padding-left: 0 !important;
      padding-right: 0 !important;
      overflow: hidden;
    }

    #CCL-{{ section.id }} .ccl-mobile {
      display: block !important;
      overflow: visible;
    }

    #CCL-{{ section.id }} .swiper-wrapper {
      align-items: flex-start;
    }

    #CCL-{{ section.id }} .ccl-slide {
      width: {{ section.settings.mobile_card_width }}vw;
      transition: transform 0.35s ease, opacity 0.35s ease;
      transform: scale({{ section.settings.mobile_side_scale }});
      opacity: {{ section.settings.mobile_side_opacity | divided_by: 100.0 }};
    }

    #CCL-{{ section.id }} .ccl-slide.swiper-slide-active {
      transform: scale(1);
      opacity: 1;
    }

    #CCL-{{ section.id }} .ccl-mobile .ccl-image-box {
      aspect-ratio: {{ section.settings.mobile_ratio }};
    }

    #CCL-{{ section.id }} .ccl-mobile-title {
      position: static;
      padding: {{ section.settings.mobile_title_top }}px 0 0;
      text-align: center;
      font-size: {{ section.settings.mobile_title_size }}px;
      line-height: 1.25;
      color: {{ section.settings.title_color }};
      font-weight: {{ section.settings.title_weight }};
      background: transparent;
      opacity: 0;
      visibility: hidden;
      transform: translateY(6px);
      transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
    }

    #CCL-{{ section.id }} .swiper-slide-active .ccl-mobile-title {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    #CCL-{{ section.id }} .ccl-arrow {
      display: flex;
      position: absolute;
      top: var(--ccl-arrow-top, 50%);
      transform: translateY(-50%);
      z-index: 8;
      width: {{ section.settings.mobile_arrow_size }}px;
      height: {{ section.settings.mobile_arrow_size }}px;
      border-radius: 50%;
      border: 0;
      background: {{ section.settings.mobile_arrow_bg }};
      color: {{ section.settings.mobile_arrow_color }};
      align-items: center;
      justify-content: center;
      padding: 0;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    }

    #CCL-{{ section.id }} .ccl-arrow::before {
      content: "";
      width: 9px;
      height: 9px;
      border-top: 2px solid currentColor;
      border-right: 2px solid currentColor;
      display: block;
    }

    #CCL-{{ section.id }} .ccl-prev {
      left: {{ section.settings.mobile_arrow_side }}px;
    }

    #CCL-{{ section.id }} .ccl-next {
      right: {{ section.settings.mobile_arrow_side }}px;
    }

    #CCL-{{ section.id }} .ccl-prev::before {
      transform: rotate(-135deg);
      margin-left: 3px;
    }

    #CCL-{{ section.id }} .ccl-next::before {
      transform: rotate(45deg);
      margin-right: 3px;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const section = document.querySelector('#CCL-{{ section.id }}');
  if (!section) return;

  function loadSwiper(callback) {
    if (window.Swiper) {
      callback();
      return;
    }

    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
    script.onload = callback;
    document.head.appendChild(script);
  }

  loadSwiper(function () {
    const slider = section.querySelector('.ccl-mobile');
    const page = section.querySelector('.ccl-page');
    const prev = section.querySelector('.ccl-prev');
    const next = section.querySelector('.ccl-next');

    if (!slider || !page) return;

    const swiper = new Swiper(slider, {
      loop: true,
      centeredSlides: true,
      slidesPerView: 'auto',
      spaceBetween: {{ section.settings.mobile_gap }},
      speed: 520,
      grabCursor: true,
      resistanceRatio: 0.65,
      watchSlidesProgress: true,
      navigation: {
        prevEl: prev,
        nextEl: next
      },
      breakpoints: {
        750: {
          enabled: false
        }
      },
      on: {
        init: function () {
          setArrowTop();
        },
        slideChangeTransitionStart: function () {
          setArrowTop();
        },
        slideChangeTransitionEnd: function () {
          setArrowTop();
        },
        resize: function () {
          setArrowTop();
        }
      }
    });

    function setArrowTop() {
      const active = section.querySelector('.ccl-slide.swiper-slide-active');
      const imageBox = active ? active.querySelector('.ccl-image-box') : section.querySelector('.ccl-image-box');
      if (!imageBox) return;

      const imageRect = imageBox.getBoundingClientRect();
      const pageRect = page.getBoundingClientRect();
      const center = imageRect.top - pageRect.top + imageRect.height / 2;

      page.style.setProperty('--ccl-arrow-top', center + 'px');
    }

    window.addEventListener('load', setArrowTop);
    window.addEventListener('resize', setArrowTop);
  });
});
</script>

