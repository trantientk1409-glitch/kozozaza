{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #FinalSlide-{{ section.id }} .slideshow__controls,
  #FinalSlide-{{ section.id }} .slider-buttons,
  #FinalSlide-{{ section.id }} .slider-counter {
    display: none !important;
  }

  #FinalSlide-{{ section.id }} .slideshow__slide {
    cursor: pointer !important;
  }

  #FinalSlide-{{ section.id }} .slideshow__text-wrapper.banner__content {
    align-items: flex-end !important;
    padding-bottom: {{ section.settings.desktop_content_bottom }}px !important;
  }

  #FinalSlide-{{ section.id }} .slideshow__text.banner__box {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
  }

  #FinalSlide-{{ section.id }} .slideshow__text * {
    color: {{ section.settings.text_color }} !important;
    text-shadow: {% if section.settings.enable_text_shadow %}0 2px 4px rgba(0,0,0,0.5){% else %}none{% endif %};
    border: none !important;
    box-shadow: none !important;
  }

  #FinalSlide-{{ section.id }} .banner__heading {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-size: {{ section.settings.heading_size }}px !important;
    font-weight: {{ section.settings.heading_weight }};
    letter-spacing: {{ section.settings.heading_spacing }}px;
    line-height: 1.15;
    margin-bottom: {{ section.settings.heading_bottom }}px;
  }

  #FinalSlide-{{ section.id }} .banner__text,
  #FinalSlide-{{ section.id }} .banner__text p {
    font-family: {{ section.settings.subheading_font.family }}, {{ section.settings.subheading_font.fallback_families }};
    font-size: {{ section.settings.subheading_size }}px !important;
    font-weight: {{ section.settings.subheading_weight }};
    letter-spacing: {{ section.settings.subheading_spacing }}px;
    line-height: 1.35;
    margin: 0;
  }

  #FinalSlide-{{ section.id }} .fake-button-text {
    display: inline-block;
    margin-top: {{ section.settings.button_top }}px;
    font-family: {{ section.settings.button_font.family }}, {{ section.settings.button_font.fallback_families }};
    font-size: {{ section.settings.button_size }}px;
    font-weight: {{ section.settings.button_weight }};
    letter-spacing: {{ section.settings.button_spacing }}px;
    text-decoration: underline;
    text-underline-offset: {{ section.settings.button_underline_offset }}px;
    text-transform: uppercase;
  }

  /* Desktop chỉ hiện ảnh desktop */
  #FinalSlide-{{ section.id }} .slide-image-desktop {
    display: block !important;
  }

  #FinalSlide-{{ section.id }} .slide-image-mobile {
    display: none !important;
  }

  #FinalSlide-{{ section.id }} .slideshow__media img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.desktop_image_fit }};
  }

  {% if section.settings.slide_height == 'adapt_image' %}
    #FinalSlide-{{ section.id }} .slideshow.banner--adapt_image {
      display: flex !important;
      flex-wrap: nowrap !important;
      overflow-x: hidden !important;
      overflow-y: hidden !important;
      min-height: 0 !important;
      height: auto !important;
    }

    #FinalSlide-{{ section.id }} .slideshow.banner--adapt_image .slideshow__slide {
      flex: 0 0 100% !important;
      width: 100% !important;
      max-width: 100% !important;
      min-height: 0 !important;
      height: auto !important;
      position: relative !important;
    }

    #FinalSlide-{{ section.id }} .slideshow.banner--adapt_image .slideshow__media {
      position: relative !important;
      height: auto !important;
      min-height: 0 !important;
      width: 100% !important;
    }

    #FinalSlide-{{ section.id }} .slideshow.banner--adapt_image .slideshow__media::before,
    #FinalSlide-{{ section.id }} .slideshow.banner--adapt_image .banner__media::before {
      display: none !important;
      content: none !important;
      padding-bottom: 0 !important;
    }

    /* Desktop adapt chỉ áp dụng cho ảnh desktop */
    #FinalSlide-{{ section.id }} .slideshow.banner--adapt_image .slide-image-desktop {
      position: relative !important;
      width: 100% !important;
      height: auto !important;
      display: block !important;
      object-fit: contain !important;
    }

    #FinalSlide-{{ section.id }} .slideshow.banner--adapt_image .slide-image-mobile {
      display: none !important;
      height: 0 !important;
      visibility: hidden !important;
    }

    #FinalSlide-{{ section.id }} .slideshow.banner--adapt_image .slideshow__text-wrapper {
      position: absolute !important;
      inset: 0 !important;
      height: 100% !important;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    #FinalSlide-{{ section.id }} .slideshow__text-wrapper.banner__content {
      padding-bottom: {{ section.settings.mobile_content_bottom }}px !important;
    }

    #FinalSlide-{{ section.id }} .banner__heading {
      font-size: {{ section.settings.mobile_heading_size }}px !important;
      letter-spacing: {{ section.settings.mobile_heading_spacing }}px;
      margin-bottom: {{ section.settings.mobile_heading_bottom }}px;
    }

    #FinalSlide-{{ section.id }} .banner__text,
    #FinalSlide-{{ section.id }} .banner__text p {
      font-size: {{ section.settings.mobile_subheading_size }}px !important;
      letter-spacing: {{ section.settings.mobile_subheading_spacing }}px;
    }

    #FinalSlide-{{ section.id }} .fake-button-text {
      margin-top: {{ section.settings.mobile_button_top }}px;
      font-size: {{ section.settings.mobile_button_size }}px;
      letter-spacing: {{ section.settings.mobile_button_spacing }}px;
    }

    /* Mobile chỉ hiện ảnh mobile */
    #FinalSlide-{{ section.id }} .slide-image-desktop {
      display: none !important;
      height: 0 !important;
      visibility: hidden !important;
    }

    #FinalSlide-{{ section.id }} .slide-image-mobile {
      display: block !important;
      height: auto !important;
      visibility: visible !important;
    }

    #FinalSlide-{{ section.id }} .slideshow__media img {
      object-fit: {{ section.settings.mobile_image_fit }};
    }

    {% if section.settings.slide_height == 'adapt_image' %}
      #FinalSlide-{{ section.id }} .slideshow.banner--adapt_image .slide-image-desktop {
        display: none !important;
        height: 0 !important;
        visibility: hidden !important;
      }

      #FinalSlide-{{ section.id }} .slideshow.banner--adapt_image .slide-image-mobile {
        position: relative !important;
        width: 100% !important;
        height: auto !important;
        display: block !important;
        visibility: visible !important;
        object-fit: contain !important;
      }
    {% endif %}
  }
{%- endstyle -%}

<slideshow-component id="FinalSlide-{{ section.id }}" class="slider-mobile-gutter" role="region">
  <div
    class="slideshow banner banner--{{ section.settings.slide_height }} grid grid--1-col slider slider--everywhere"
    id="Slider-{{ section.id }}"
    data-autoplay="true"
    data-speed="{{ section.settings.change_slides_speed }}"
  >
    {%- for block in section.blocks -%}
      <div
        class="slideshow__slide grid__item grid--1-col slider__slide"
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        {{ block.shopify_attributes }}
        {% if block.settings.link != blank %}
          onclick="window.location.href='{{ block.settings.link }}';"
        {% endif %}
      >
        <div class="slideshow__media banner__media media">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 3840
              | image_tag:
                height: 'auto',
                sizes: '100vw',
                widths: '375, 750, 1100, 1500, 2000, 3000, 3840',
                class: 'slide-image-desktop',
                alt: block.settings.heading | default: shop.name
            }}
          {%- endif -%}

          {%- if block.settings.mobile_image != blank -%}
            {{
              block.settings.mobile_image
              | image_url: width: 1200
              | image_tag:
                height: 'auto',
                sizes: '100vw',
                widths: '375, 550, 750, 900, 1200',
                class: 'slide-image-mobile',
                alt: block.settings.heading | default: shop.name
            }}
          {%- elsif block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                height: 'auto',
                sizes: '100vw',
                widths: '375, 550, 750, 900, 1200',
                class: 'slide-image-mobile'
            }}
          {%- endif -%}

          {%- if block.settings.image == blank and block.settings.mobile_image == blank -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        <div class="slideshow__text-wrapper banner__content banner__content--bottom-center page-width">
          <div class="slideshow__text banner__box slideshow__text--center">
            {%- if block.settings.heading != blank -%}
              <h2 class="banner__heading h1">{{ block.settings.heading }}</h2>
            {%- endif -%}

            {%- if block.settings.subheading != blank -%}
              <div class="banner__text rte">
                <p>{{ block.settings.subheading }}</p>
              </div>
            {%- endif -%}

            {%- if block.settings.button_label != blank -%}
              <span class="fake-button-text">
                {{ block.settings.button_label | escape }}
              </span>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</slideshow-component>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slideshow = document.querySelector('#Slider-{{ section.id }}');
    if (!slideshow) return;

    const slides = slideshow.querySelectorAll('.slideshow__slide');
    if (slides.length <= 1) return;

    let speed = {{ section.settings.change_slides_speed | times: 1000 }};
    let index = 0;

    setInterval(() => {
      index = (index + 1) % slides.length;
      slideshow.scrollTo({
        left: slides[index].offsetLeft,
        behavior: 'smooth'
      });
    }, speed);
  });
</script>

