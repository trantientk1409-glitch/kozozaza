<section id="CFCH-{{ section.id }}" class="cfch-section">
  <div class="cfch-header">
    <h2>{{ section.settings.heading }}</h2>

    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="cfch-shop-link">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>

  <div class="cfch-wrap">
    <button class="cfch-arrow cfch-prev" type="button" aria-label="Previous"></button>

    <div class="cfch-slider">
      {% assign collection = section.settings.collection %}

      {% if collection != blank %}
        {% for product in collection.products limit: section.settings.product_limit %}
          <div class="cfch-card">
            <a href="{{ product.url }}" class="cfch-card-link">
              <div class="cfch-image-box">
                {% if section.settings.show_badge and section.settings.badge_text != blank %}
  <div class="cfch-badge">{{ section.settings.badge_text }}</div>
{% endif %}

                {% if section.settings.show_heart %}
                  <div class="cfch-heart">♡</div>
                {% endif %}

                {% if product.featured_image != blank %}
                  {{
                    product.featured_image
                    | image_url: width: 900
                    | image_tag: loading: 'lazy', class: 'cfch-img cfch-img-primary'
                  }}
                {% endif %}

                {% if product.images[1] != blank %}
                  {{
                    product.images[1]
                    | image_url: width: 900
                    | image_tag: loading: 'lazy', class: 'cfch-img cfch-img-secondary'
                  }}
                {% endif %}

                {% if section.settings.show_dots %}
                  <div class="cfch-mini-dots">
                    <span></span>
                    <span></span>
                  </div>
                {% endif %}
              </div>

              {% if section.settings.show_quick_add %}
                <div class="cfch-add-bar">
                  {{ section.settings.quick_add_text }}
                </div>
              {% endif %}

              <div class="cfch-info">
                {% if section.settings.show_vendor %}
                  <div class="cfch-vendor">{{ product.vendor }}</div>
                {% endif %}

                <div class="cfch-title">{{ product.title }}</div>

                {% if section.settings.show_price %}
                  <div class="cfch-price">
                    {{ product.price | money }}
                  </div>
                {% endif %}
              </div>
            </a>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <button class="cfch-arrow cfch-next" type="button" aria-label="Next"></button>
  </div>
</section>

<style>
  #CFCH-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.section_bg }};
  }

  #CFCH-{{ section.id }} .cfch-header {
    max-width: {{ section.settings.section_width }}px;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-left: {{ section.settings.side_padding }}px;
    padding-right: {{ section.settings.side_padding }}px;
    margin-bottom: {{ section.settings.header_bottom }}px;
  }

  #CFCH-{{ section.id }} .cfch-header h2 {
    margin: 0;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    color: {{ section.settings.heading_color }};
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
  }

  #CFCH-{{ section.id }} .cfch-shop-link {
    color: {{ section.settings.button_color }};
    font-size: {{ section.settings.button_size }}px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  #CFCH-{{ section.id }} .cfch-wrap {
    max-width: {{ section.settings.section_width }}px;
    margin-left: auto;
    margin-right: auto;
    padding-left: {{ section.settings.side_padding }}px;
    padding-right: {{ section.settings.side_padding }}px;
    position: relative;
    overflow: hidden;
  }

  #CFCH-{{ section.id }} .cfch-slider {
    display: flex;
    gap: {{ section.settings.product_gap }}px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #CFCH-{{ section.id }} .cfch-slider::-webkit-scrollbar {
    display: none;
  }

  #CFCH-{{ section.id }} .cfch-card {
    flex: 0 0 calc((100% - ({{ section.settings.product_gap }}px * 4)) / 5);
    max-width: calc((100% - ({{ section.settings.product_gap }}px * 4)) / 5);
    scroll-snap-align: start;
  }

  #CFCH-{{ section.id }} .cfch-card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #CFCH-{{ section.id }} .cfch-image-box {
    position: relative;
    background: {{ section.settings.card_bg }};
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
  }

  #CFCH-{{ section.id }} .cfch-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: {{ section.settings.image_fit }};
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  #CFCH-{{ section.id }} .cfch-img-primary {
    opacity: 1;
    z-index: 1;
  }

  #CFCH-{{ section.id }} .cfch-img-secondary {
    opacity: 0;
    z-index: 2;
  }

  #CFCH-{{ section.id }} .cfch-card:hover .cfch-img-primary {
    opacity: 0;
  }

  #CFCH-{{ section.id }} .cfch-card:hover .cfch-img-secondary {
    opacity: 1;
  }

  #CFCH-{{ section.id }} .cfch-badge {
    position: absolute;
    top: {{ section.settings.badge_top }}px;
    left: {{ section.settings.badge_left }}px;
    z-index: 5;
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_color }};
    font-size: {{ section.settings.badge_size }}px;
    padding: 4px 10px;
    line-height: 1;
  }

  #CFCH-{{ section.id }} .cfch-heart {
    position: absolute;
    top: {{ section.settings.heart_top }}px;
    right: {{ section.settings.heart_right }}px;
    z-index: 5;
    color: {{ section.settings.heart_color }};
    font-size: {{ section.settings.heart_size }}px;
    line-height: 1;
  }

  #CFCH-{{ section.id }} .cfch-mini-dots {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  #CFCH-{{ section.id }} .cfch-mini-dots span {
    display: block;
    width: 2px;
    height: 26px;
    background: #cfcfcf;
  }

  #CFCH-{{ section.id }} .cfch-mini-dots span:first-child {
    background: #777;
  }

  #CFCH-{{ section.id }} .cfch-card:hover .cfch-mini-dots span:first-child {
    background: #cfcfcf;
  }

  #CFCH-{{ section.id }} .cfch-card:hover .cfch-mini-dots span:last-child {
    background: #777;
  }

  #CFCH-{{ section.id }} .cfch-add-bar {
    height: {{ section.settings.quick_add_height }}px;
    border: 1px solid {{ section.settings.quick_add_border }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ section.settings.quick_add_size }}px;
    background: {{ section.settings.quick_add_bg }};
    color: {{ section.settings.quick_add_color }};
  }

  #CFCH-{{ section.id }} .cfch-info {
    text-align: {{ section.settings.text_align }};
    padding-top: {{ section.settings.info_top }}px;
  }

  #CFCH-{{ section.id }} .cfch-vendor {
    font-size: {{ section.settings.vendor_size }}px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 5px;
  }

  #CFCH-{{ section.id }} .cfch-title {
    font-size: {{ section.settings.title_size }}px;
    line-height: 1.35;
    color: {{ section.settings.title_color }};
  }

  #CFCH-{{ section.id }} .cfch-price {
    margin-top: 6px;
    font-size: {{ section.settings.price_size }}px;
    font-weight: 700;
    color: {{ section.settings.price_color }};
  }

  #CFCH-{{ section.id }} .cfch-arrow {
    position: absolute;
    top: var(--cfch-arrow-top, 50%);
    transform: translateY(-50%);
    z-index: 10;
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    border-radius: 50%;
    border: 0;
    background: {{ section.settings.arrow_bg }};
    color: {{ section.settings.arrow_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    cursor: pointer;
  }

  #CFCH-{{ section.id }} .cfch-arrow::before {
    content: "";
    width: 9px;
    height: 9px;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
    display: block;
  }

  #CFCH-{{ section.id }} .cfch-prev::before {
    transform: rotate(-135deg);
    margin-left: 3px;
  }

  #CFCH-{{ section.id }} .cfch-next::before {
    transform: rotate(45deg);
    margin-right: 3px;
  }

  #CFCH-{{ section.id }} .cfch-prev {
    left: {{ section.settings.arrow_side }}px;
  }

  #CFCH-{{ section.id }} .cfch-next {
    right: {{ section.settings.arrow_side }}px;
  }

  @media screen and (max-width: 749px) {
    #CFCH-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #CFCH-{{ section.id }} .cfch-header {
      padding-left: {{ section.settings.mobile_side_padding }}px;
      padding-right: {{ section.settings.mobile_side_padding }}px;
      margin-bottom: {{ section.settings.mobile_header_bottom }}px;
    }

    #CFCH-{{ section.id }} .cfch-header h2 {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #CFCH-{{ section.id }} .cfch-shop-link {
      font-size: {{ section.settings.mobile_button_size }}px;
    }

    #CFCH-{{ section.id }} .cfch-wrap {
      padding-left: {{ section.settings.mobile_side_padding }}px;
      padding-right: {{ section.settings.mobile_side_padding }}px;
    }

    #CFCH-{{ section.id }} .cfch-slider {
      gap: {{ section.settings.mobile_product_gap }}px;
    }

    #CFCH-{{ section.id }} .cfch-card {
      flex: 0 0 100%;
      max-width: 100%;
    }

    #CFCH-{{ section.id }} .cfch-image-box {
      aspect-ratio: {{ section.settings.mobile_image_ratio }};
    }

    #CFCH-{{ section.id }} .cfch-title {
      font-size: {{ section.settings.mobile_title_size }}px;
    }

    #CFCH-{{ section.id }} .cfch-price {
      font-size: {{ section.settings.mobile_price_size }}px;
    }

    #CFCH-{{ section.id }} .cfch-vendor {
      font-size: {{ section.settings.mobile_vendor_size }}px;
    }

    #CFCH-{{ section.id }} .cfch-add-bar {
      height: {{ section.settings.mobile_quick_add_height }}px;
      font-size: {{ section.settings.mobile_quick_add_size }}px;
    }

    #CFCH-{{ section.id }} .cfch-prev {
      left: calc({{ section.settings.mobile_side_padding }}px + 8px);
    }

    #CFCH-{{ section.id }} .cfch-next {
      right: calc({{ section.settings.mobile_side_padding }}px + 8px);
    }

    #CFCH-{{ section.id }} .cfch-mini-dots {
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      flex-direction: column;
      gap: 6px;
    }

    #CFCH-{{ section.id }} .cfch-mini-dots span {
      width: 2px;
      height: 26px;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const section = document.querySelector('#CFCH-{{ section.id }}');
  if (!section) return;

  const slider = section.querySelector('.cfch-slider');
  const prev = section.querySelector('.cfch-prev');
  const next = section.querySelector('.cfch-next');

  function setArrowPosition() {
    const imageBox = section.querySelector('.cfch-image-box');
    const wrap = section.querySelector('.cfch-wrap');
    if (!imageBox || !wrap) return;

    const imageRect = imageBox.getBoundingClientRect();
    const wrapRect = wrap.getBoundingClientRect();
    const center = imageRect.top - wrapRect.top + imageRect.height / 2;

    wrap.style.setProperty('--cfch-arrow-top', center + 'px');
  }

  setArrowPosition();
  window.addEventListener('resize', setArrowPosition);
  window.addEventListener('load', setArrowPosition);

  if (!slider || !prev || !next) return;

  function getScrollAmount() {
    const card = slider.querySelector('.cfch-card');
    if (!card) return slider.clientWidth;
    const gap = parseFloat(getComputedStyle(slider).gap) || 0;
    return card.offsetWidth + gap;
  }

  next.addEventListener('click', function () {
    slider.scrollBy({
      left: getScrollAmount(),
      behavior: 'smooth'
    });
  });

  prev.addEventListener('click', function () {
    slider.scrollBy({
      left: -getScrollAmount(),
      behavior: 'smooth'
    });
  });
});
</script>

