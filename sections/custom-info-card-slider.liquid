<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<section id="CICS-{{ section.id }}" class="cics-section">
  <div class="cics-header">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}
  </div>

  <div class="cics-wrap">
    <button class="cics-arrow cics-prev" type="button" aria-label="Previous"></button>

    <div class="cics-slider swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="cics-card swiper-slide" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="cics-image-box">
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag: loading: 'lazy', class: 'cics-image'
                }}
              </div>
            {% endif %}

            <div class="cics-content">
              {% if block.settings.title != blank %}
                <h3>{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="cics-text">{{ block.settings.text }}</div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <button class="cics-arrow cics-next" type="button" aria-label="Next"></button>
  </div>
</section>

<style>
  #CICS-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.section_bg }};
    overflow: hidden;
  }

  #CICS-{{ section.id }} .cics-header {
    max-width: {{ section.settings.section_width }}px;
    margin: {{ section.settings.desktop_heading_top }}px auto {{ section.settings.desktop_heading_image_gap }}px;
    padding-left: {{ section.settings.desktop_heading_padding }}px;
    padding-right: {{ section.settings.desktop_heading_padding }}px;
  }

  #CICS-{{ section.id }} .cics-header h2 {
    margin: 0;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.2;
    font-weight: {{ section.settings.heading_weight }};
    color: {{ section.settings.heading_color }};
    text-transform: uppercase;
    letter-spacing: {{ section.settings.heading_spacing }}px;
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
  }

  #CICS-{{ section.id }} .cics-wrap {
    max-width: {{ section.settings.section_width }}px;
    margin: 0 auto;
    position: relative;
    padding-left: {{ section.settings.side_padding }}px;
    padding-right: {{ section.settings.side_padding }}px;
  }

  #CICS-{{ section.id }} .cics-slider {
    overflow: hidden;
  }

  #CICS-{{ section.id }} .swiper-wrapper {
    display: flex;
  }

  #CICS-{{ section.id }} .cics-card {
    flex: 0 0 calc((100% - ({{ section.settings.card_gap }}px * ({{ section.settings.desktop_columns }} - 1))) / {{ section.settings.desktop_columns }});
    max-width: calc((100% - ({{ section.settings.card_gap }}px * ({{ section.settings.desktop_columns }} - 1))) / {{ section.settings.desktop_columns }});
    margin-right: {{ section.settings.card_gap }}px;
  }

  #CICS-{{ section.id }} .cics-image-box {
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
    background: {{ section.settings.image_bg }};
  }

  #CICS-{{ section.id }} .cics-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: {{ section.settings.image_fit }};
    transition: transform 0.35s ease;
  }

  #CICS-{{ section.id }} .cics-card:hover .cics-image {
    transform: scale({{ section.settings.hover_zoom }});
  }

  #CICS-{{ section.id }} .cics-content {
    padding-top: {{ section.settings.text_top }}px;
    text-align: {{ section.settings.text_align }};
  }

  #CICS-{{ section.id }} .cics-content h3 {
    margin: 0 0 {{ section.settings.title_bottom }}px;
    font-size: {{ section.settings.title_size }}px;
    line-height: 1.25;
    font-weight: {{ section.settings.title_weight }};
    color: {{ section.settings.title_color }};
    text-transform: uppercase;
    letter-spacing: {{ section.settings.title_spacing }}px;
    font-family: {{ section.settings.card_title_font.family }}, {{ section.settings.card_title_font.fallback_families }};
  }

  #CICS-{{ section.id }} .cics-text {
    font-size: {{ section.settings.body_size }}px;
    line-height: {{ section.settings.body_line_height }};
    color: {{ section.settings.body_color }};
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
  }

  #CICS-{{ section.id }} .cics-arrow {
    position: absolute;
    top: var(--cics-arrow-top, 40%);
    transform: translateY(-50%);
    z-index: 8;
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    border-radius: 50%;
    border: 0;
    background: {{ section.settings.arrow_bg }};
    color: {{ section.settings.arrow_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
  }

  #CICS-{{ section.id }} .cics-arrow::before {
    content: "";
    width: 9px;
    height: 9px;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
    display: block;
  }

  #CICS-{{ section.id }} .cics-prev {
    left: {{ section.settings.arrow_side }}px;
  }

  #CICS-{{ section.id }} .cics-next {
    right: {{ section.settings.arrow_side }}px;
  }

  #CICS-{{ section.id }} .cics-prev::before {
    transform: rotate(-135deg);
    margin-left: 3px;
  }

  #CICS-{{ section.id }} .cics-next::before {
    transform: rotate(45deg);
    margin-right: 3px;
  }

  @media screen and (min-width: 750px) {
    #CICS-{{ section.id }} .swiper-wrapper {
      gap: 0;
      transform: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    #CICS-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #CICS-{{ section.id }} .cics-header {
      margin-top: {{ section.settings.mobile_heading_top }}px;
      margin-bottom: {{ section.settings.mobile_heading_image_gap }}px;
      padding-left: {{ section.settings.mobile_heading_padding }}px;
      padding-right: {{ section.settings.mobile_heading_padding }}px;
    }

    #CICS-{{ section.id }} .cics-header h2 {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #CICS-{{ section.id }} .cics-wrap {
      padding-left: 0;
      padding-right: 0;
      overflow: hidden;
    }

    #CICS-{{ section.id }} .cics-slider {
      overflow: visible;
    }

    #CICS-{{ section.id }} .cics-card {
      width: {{ section.settings.mobile_card_width }}vw !important;
      flex: none;
      max-width: none;
      margin-right: 0;
      transform: scale({{ section.settings.mobile_side_scale }});
      opacity: {{ section.settings.mobile_side_opacity | divided_by: 100.0 }};
      transition: transform 0.35s ease, opacity 0.35s ease;
    }

    #CICS-{{ section.id }} .cics-card.swiper-slide-active {
      transform: scale(1);
      opacity: 1;
    }

    #CICS-{{ section.id }} .cics-image-box {
      aspect-ratio: {{ section.settings.mobile_image_ratio }};
    }

    #CICS-{{ section.id }} .cics-content {
      display: none;
    }

    #CICS-{{ section.id }} .swiper-slide-active .cics-content {
      display: block;
      padding-top: {{ section.settings.mobile_text_top }}px;
      text-align: center;
    }

    #CICS-{{ section.id }} .cics-content h3 {
      font-size: {{ section.settings.mobile_title_size }}px;
      text-align: center;
    }

    #CICS-{{ section.id }} .cics-text {
      font-size: {{ section.settings.mobile_body_size }}px;
      text-align: center;
    }

    #CICS-{{ section.id }} .cics-arrow {
      width: {{ section.settings.mobile_arrow_size }}px;
      height: {{ section.settings.mobile_arrow_size }}px;
    }

    #CICS-{{ section.id }} .cics-prev {
      left: 8px;
    }

    #CICS-{{ section.id }} .cics-next {
      right: 8px;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const section = document.querySelector('#CICS-{{ section.id }}');
  if (!section) return;

  function loadSwiper(callback) {
    if (window.Swiper) {
      callback();
      return;
    }

    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
    script.onload = callback;
    document.head.appendChild(script);
  }

  loadSwiper(function () {
    const slider = section.querySelector('.cics-slider');
    const wrap = section.querySelector('.cics-wrap');
    const prev = section.querySelector('.cics-prev');
    const next = section.querySelector('.cics-next');

    if (!slider || !wrap) return;

    const swiper = new Swiper(slider, {
      loop: true,
      centeredSlides: true,
      slidesPerView: 'auto',
      spaceBetween: {{ section.settings.mobile_card_gap }},
      speed: 520,
      grabCursor: true,
      resistanceRatio: 0.65,
      watchSlidesProgress: true,
      navigation: {
        prevEl: prev,
        nextEl: next
      },
      breakpoints: {
        750: {
          enabled: false,
          slidesPerView: {{ section.settings.desktop_columns }},
          spaceBetween: {{ section.settings.card_gap }},
          loop: false,
          centeredSlides: false
        }
      },
      on: {
        init: function () {
          setArrowTop();
        },
        slideChangeTransitionStart: function () {
          setArrowTop();
        },
        slideChangeTransitionEnd: function () {
          setArrowTop();
        },
        resize: function () {
          setArrowTop();
        }
      }
    });

    function setArrowTop() {
      const active = section.querySelector('.cics-card.swiper-slide-active') || section.querySelector('.cics-card');
      const imageBox = active ? active.querySelector('.cics-image-box') : null;
      if (!imageBox) return;

      const imageRect = imageBox.getBoundingClientRect();
      const wrapRect = wrap.getBoundingClientRect();
      const center = imageRect.top - wrapRect.top + imageRect.height / 2;

      wrap.style.setProperty('--cics-arrow-top', center + 'px');
    }

    window.addEventListener('load', setArrowTop);
    window.addEventListener('resize', setArrowTop);
  });
});
</script>

