{% style %}
#shopify-section-{{ section.id }} .si-section {
  background: {{ section.settings.bg_color }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

#shopify-section-{{ section.id }} .si-inner {
  width: calc(100% - {{ section.settings.desktop_side_spacing }}px);
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

#shopify-section-{{ section.id }} .si-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
  gap: {{ section.settings.desktop_gap }}px;
  align-items: center;
}

#shopify-section-{{ section.id }} .si-item {
  display: flex;
  align-items: center;
  justify-content: {{ section.settings.desktop_align }};
  gap: {{ section.settings.desktop_icon_gap }}px;
  text-align: left;
}

#shopify-section-{{ section.id }} .si-icon-wrap {
  width: {{ section.settings.icon_size_desktop }}px;
  height: {{ section.settings.icon_size_desktop }}px;
  flex: 0 0 {{ section.settings.icon_size_desktop }}px;
  display: flex;
  align-items: center;
  justify-content: center;
}

#shopify-section-{{ section.id }} .si-icon-wrap img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

#shopify-section-{{ section.id }} .si-emoji {
  font-size: {{ section.settings.icon_size_desktop }}px;
  line-height: 1;
  color: {{ section.settings.icon_color }};
}

#shopify-section-{{ section.id }} .si-title {
  color: {{ section.settings.title_color }};
  font-size: {{ section.settings.title_size_desktop }}px;
  font-weight: {{ section.settings.title_weight }};
  line-height: 1.25;
  margin: 0;
  letter-spacing: {{ section.settings.title_letter_spacing }}px;
}

#shopify-section-{{ section.id }} .si-text {
  color: {{ section.settings.text_color }};
  font-size: {{ section.settings.text_size_desktop }}px;
  font-weight: {{ section.settings.text_weight }};
  line-height: {{ section.settings.text_line_height }};
  margin: {{ section.settings.text_top_spacing }}px 0 0;
}

@media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} .si-section {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .si-inner {
    width: auto;
    margin-left: {{ section.settings.mobile_side_spacing }}px;
    margin-right: {{ section.settings.mobile_side_spacing }}px;
  }

  #shopify-section-{{ section.id }} .si-grid {
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    gap: {{ section.settings.mobile_row_gap }}px {{ section.settings.mobile_column_gap }}px;
  }

  #shopify-section-{{ section.id }} .si-item {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: {{ section.settings.mobile_icon_gap }}px;
  }

  #shopify-section-{{ section.id }} .si-icon-wrap {
    width: {{ section.settings.icon_size_mobile }}px;
    height: {{ section.settings.icon_size_mobile }}px;
    flex-basis: {{ section.settings.icon_size_mobile }}px;
  }

  #shopify-section-{{ section.id }} .si-emoji {
    font-size: {{ section.settings.icon_size_mobile }}px;
  }

  #shopify-section-{{ section.id }} .si-title {
    font-size: {{ section.settings.title_size_mobile }}px;
  }

  #shopify-section-{{ section.id }} .si-text {
    font-size: {{ section.settings.text_size_mobile }}px;
    margin-top: {{ section.settings.mobile_text_top_spacing }}px;
  }
}
{% endstyle %}

<div class="si-section">
  <div class="si-inner">
    <div class="si-grid">
      {% for block in section.blocks %}
        <div class="si-item" {{ block.shopify_attributes }}>
          <div class="si-icon-wrap">
            {% if block.settings.icon_image != blank %}
              <img src="{{ block.settings.icon_image | img_url: '120x120' }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {% else %}
              <span class="si-emoji">{{ block.settings.icon_text }}</span>
            {% endif %}
          </div>

          <div class="si-content">
            {% if block.settings.title != blank %}
              <h3 class="si-title">{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <p class="si-text">{{ block.settings.text }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

