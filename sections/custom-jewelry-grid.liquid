{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .custom-jewelry-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.grid_gap_mobile }}rem;
    {% if section.settings.full_width %}
      padding-left: 1rem;
      padding-right: 1rem;
    {% endif %}
  }

  @media screen and (min-width: 990px) {
    .custom-jewelry-grid {
      grid-template-columns: 1fr 1fr;
      gap: {{ section.settings.grid_gap_desktop }}rem;
      {% if section.settings.full_width %}
        padding-left: 2rem;
        padding-right: 2rem;
      {% endif %}
    }
  }

  .custom-jewelry__banner {
    position: relative;
    border-radius: var(--media-radius);
    overflow: hidden;
    height: 100%;
    min-height: 400px;
  }

  .custom-jewelry__banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-long) ease;
  }

  .custom-jewelry__banner:hover img {
    transform: scale(1.05);
  }

  .custom-jewelry__banner-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 3rem;
    background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
    color: white;
  }

  .custom-jewelry__banner-title {
    margin: 0;
    color: {{ section.settings.banner_title_color }};
    font-size: {{ section.settings.banner_title_font_size }}rem;
    font-weight: 600;
  }

  .custom-jewelry__categories {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.grid_gap_mobile }}rem;
  }

  @media screen and (min-width: 990px) {
    .custom-jewelry__categories {
      gap: {{ section.settings.grid_gap_desktop }}rem;
    }
  }

  .custom-jewelry__category-item {
    position: relative;
    border-radius: var(--media-radius);
    overflow: hidden;
    aspect-ratio: 1 / 1;
    cursor: pointer;
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }

  .custom-jewelry__category-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-long) ease;
  }

  .custom-jewelry__category-item:hover img {
    transform: scale(1.1);
  }

  .custom-jewelry__category-info {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 1.5rem;
    background: transparent; /* No background as requested */
    backdrop-filter: none;
    text-align: center;
    transition: transform var(--duration-default) ease;
  }

  .custom-jewelry__category-item:hover .custom-jewelry__category-info {
    transform: translateY(-5px);
  }

  .custom-jewelry__category-title {
    margin: 0;
    font-size: {{ section.settings.category_font_size }}rem;
    font-weight: 500;
    color: {{ section.settings.category_title_color }};
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    text-shadow: 0 0 10px rgba(255,255,255,0.5); /* Subtle shadow for readability on transparent background */
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  <div class="{% if section.settings.full_width %}page-width-full{% else %}page-width{% endif %}">
    <div class="custom-jewelry-grid">
      <div class="custom-jewelry__banner">
        {%- if section.settings.banner_image != blank -%}
          {{ section.settings.banner_image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        <div class="custom-jewelry__banner-content">
          <h2 class="custom-jewelry__banner-title">{{ section.settings.banner_title }}</h2>
        </div>
      </div>
      <div class="custom-jewelry__categories">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link }}" class="custom-jewelry__category-item" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy' }}
            {%- else -%}
              {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <div class="custom-jewelry__category-info">
              <h3 class="custom-jewelry__category-title">{{ block.settings.title }}</h3>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Jewelry Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width (Toàn màn hình)",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "inline_richtext",
      "id": "banner_title",
      "default": "Custom Your Jewelry",
      "label": "Banner Title"
    },
    {
      "type": "header",
      "content": "Banner Design"
    },
    {
      "type": "range",
      "id": "banner_title_font_size",
      "min": 1,
      "max": 6,
      "step": 0.1,
      "unit": "rem",
      "label": "Banner Title Font Size",
      "default": 3.2
    },
    {
      "type": "color",
      "id": "banner_title_color",
      "label": "Banner Title Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Category Grid Design"
    },
    {
      "type": "range",
      "id": "category_font_size",
      "min": 0.8,
      "max": 3,
      "step": 0.1,
      "unit": "rem",
      "label": "Category Title Font Size",
      "default": 1.4
    },
    {
      "type": "color",
      "id": "category_title_color",
      "label": "Category Title Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "grid_gap_desktop",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "rem",
      "label": "Grid Gap (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "rem",
      "label": "Grid Gap (Mobile)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Jewelry Grid",
      "blocks": [
        {
          "type": "category",
          "settings": { "title": "Necklace" }
        },
        {
          "type": "category",
          "settings": { "title": "Ring" }
        },
        {
          "type": "category",
          "settings": { "title": "Earrings" }
        },
        {
          "type": "category",
          "settings": { "title": "Bracelet" }
        }
      ]
    }
  ]
}
{% endschema %}
