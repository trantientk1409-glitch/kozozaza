<section id="CSB-{{ section.id }}" class="csb-section">
  <div class="csb-banner">
    {% if section.settings.image != blank %}
  {{
    section.settings.image
    | image_url: width: 2400
    | image_tag: loading: 'lazy', class: 'csb-image csb-image-desktop', alt: section.settings.heading | default: shop.name
  }}
{% endif %}

{% if section.settings.mobile_image != blank %}
  {{
    section.settings.mobile_image
    | image_url: width: 900
    | image_tag: loading: 'lazy', class: 'csb-image csb-image-mobile', alt: section.settings.heading | default: shop.name
  }}
{% elsif section.settings.image != blank %}
  {{
    section.settings.image
    | image_url: width: 900
    | image_tag: loading: 'lazy', class: 'csb-image csb-image-mobile'
  }}
{% endif %}

    <div class="csb-content">
      {% if section.settings.eyebrow != blank %}
        <div class="csb-eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="csb-heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="csb-button">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #CSB-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

#CSB-{{ section.id }} .csb-banner {
  position: relative;
  height: {{ section.settings.desktop_height }}px;
  overflow: hidden;
}

#CSB-{{ section.id }} .csb-image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: {{ section.settings.desktop_image_position }};
}

#CSB-{{ section.id }} .csb-content {
  position: absolute;
  top: 50%;
  right: 12%;
  transform: translateY(-50%);
  text-align: center;
  max-width: {{ section.settings.content_width }}px;
  color: {{ section.settings.text_color }};
}

  #CSB-{{ section.id }} .csb-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: {{ section.settings.desktop_height }}px;
  }

  #CSB-{{ section.id }} .csb-image-side,
  #CSB-{{ section.id }} .csb-content-side {
    min-height: {{ section.settings.desktop_height }}px;
  }

  #CSB-{{ section.id }} .csb-image-side {
    overflow: hidden;
  }

  #CSB-{{ section.id }} .csb-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: {{ section.settings.desktop_image_position }};
  }

  #CSB-{{ section.id }} .csb-content-side {
    background:
      {% if section.settings.background_image != blank %}
        url({{ section.settings.background_image | image_url: width: 1600 }})
      {% else %}
        {{ section.settings.content_background }}
      {% endif %};
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px;
  }

  #CSB-{{ section.id }} .csb-content {
    max-width: {{ section.settings.content_width }}px;
  }

  #CSB-{{ section.id }} .csb-eyebrow {
    margin-bottom: {{ section.settings.eyebrow_bottom }}px;
    font-size: {{ section.settings.eyebrow_size }}px;
    line-height: 1.3;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    color: {{ section.settings.text_color }};
    font-weight: {{ section.settings.eyebrow_weight }};
    text-transform: uppercase;
  }

  #CSB-{{ section.id }} .csb-heading {
    margin: 0;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.35;
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    color: {{ section.settings.text_color }};
    font-weight: {{ section.settings.heading_weight }};
    text-transform: uppercase;
  }

  #CSB-{{ section.id }} .csb-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: {{ section.settings.button_top }}px;
    min-width: {{ section.settings.button_width }}px;
    min-height: {{ section.settings.button_height }}px;
    padding: 0 24px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_color }};
    font-size: {{ section.settings.button_size }}px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  #CSB-{{ section.id }} .csb-image-mobile {
  display: none;
}

@media screen and (max-width: 749px) {
  #CSB-{{ section.id }} .csb-image-desktop {
    display: none;
  }

  #CSB-{{ section.id }} .csb-image-mobile {
    display: block;
  }
}

  @media screen and (min-width: 750px) {
    {% if section.settings.image_position == 'right' %}
      #CSB-{{ section.id }} .csb-image-side {
        order: 2;
      }

      #CSB-{{ section.id }} .csb-content-side {
        order: 1;
      }
    {% endif %}
  }

 @media screen and (max-width: 749px) {
  #CSB-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #CSB-{{ section.id }} .csb-banner {
    height: {{ section.settings.mobile_height }}px;
  }

  #CSB-{{ section.id }} .csb-image {
    object-position: {{ section.settings.mobile_image_position }};
  }

  #CSB-{{ section.id }} .csb-content {
    top: auto;
    bottom: 28px;
    left: 50%;
    right: auto;
    transform: translateX(-50%);
    width: 90%;
  }
    #CSB-{{ section.id }} .csb-wrap {
      display: block;
      min-height: auto;
      position: relative;
    }

    #CSB-{{ section.id }} .csb-image-side,
    #CSB-{{ section.id }} .csb-content-side {
      min-height: {{ section.settings.mobile_height }}px;
    }

    #CSB-{{ section.id }} .csb-image-side {
      position: relative;
      height: {{ section.settings.mobile_height }}px;
    }

    #CSB-{{ section.id }} .csb-image {
      object-position: {{ section.settings.mobile_image_position }};
    }

    #CSB-{{ section.id }} .csb-content-side {
      position: absolute;
      inset: 0;
      background: transparent;
      padding: 24px;
      min-height: auto;
      display: flex;
      align-items: {{ section.settings.mobile_vertical_position }};
      justify-content: center;
      text-align: center;
    }

    #CSB-{{ section.id }} .csb-eyebrow {
      font-size: {{ section.settings.mobile_eyebrow_size }}px;
      margin-bottom: {{ section.settings.mobile_eyebrow_bottom }}px;
    }

    #CSB-{{ section.id }} .csb-heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #CSB-{{ section.id }} .csb-button {
      margin-top: {{ section.settings.mobile_button_top }}px;
      min-width: {{ section.settings.mobile_button_width }}px;
      min-height: {{ section.settings.mobile_button_height }}px;
      font-size: {{ section.settings.mobile_button_size }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom split banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image"
    },
    {
  "type": "image_picker",
  "id": "mobile_image",
  "label": "Mobile image"
},
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position desktop",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text",
      "default": "CÁC DỊP LỄ RƯỚC LỄ LẦN ĐẦU"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CHO MỘT CỘT MỐC Ý NGHĨA"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "MUA SẮM BỘ SƯU TẬP"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "Content background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#071743"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 400,
      "max": 1000,
      "step": 20,
      "default": 720
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 360,
      "max": 900,
      "step": 20,
      "default": 640
    },
    {
      "type": "text",
      "id": "desktop_image_position",
      "label": "Desktop image position",
      "default": "center center"
    },
    {
      "type": "text",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "default": "center center"
    },
    {
      "type": "select",
      "id": "mobile_vertical_position",
      "label": "Mobile content vertical position",
      "default": "flex-end",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ]
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content max width",
      "min": 260,
      "max": 700,
      "step": 20,
      "default": 520
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Small text size desktop",
      "min": 10,
      "max": 32,
      "step": 1,
      "default": 22
    },
    {
      "type": "range",
      "id": "mobile_eyebrow_size",
      "label": "Small text size mobile",
      "min": 8,
      "max": 24,
      "step": 1,
      "default": 11
    },
    {
      "type": "select",
      "id": "eyebrow_weight",
      "label": "Small text weight",
      "default": "600",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "range",
      "id": "eyebrow_letter_spacing",
      "label": "Small text letter spacing",
      "min": 0,
      "max": 8,
      "step": 0.5,
      "default": 1
    },
    {
      "type": "range",
      "id": "eyebrow_bottom",
      "label": "Small text bottom spacing desktop",
