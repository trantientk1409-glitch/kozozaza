      "max": 40,
      "step": 1,
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_eyebrow_bottom",
      "label": "Small text bottom spacing mobile",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size desktop",
      "min": 16,
      "max": 60,
      "step": 1,
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Heading size mobile",
      "min": 10,
      "max": 34,
      "step": 1,
      "default": 12
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
