    {
      "type": "range",
      "id": "mobile_button_top",
      "label": "Button top spacing mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "button_width",
      "label": "Button width desktop",
      "min": 120,
      "max": 340,
      "step": 10,
      "default": 230
    },
    {
      "type": "range",
      "id": "mobile_button_width",
      "label": "Button width mobile",
      "min": 90,
      "max": 260,
      "step": 10,
      "default": 120
    },
    {
      "type": "range",
      "id": "button_height",
      "label": "Button height desktop",
      "min": 34,
      "max": 80,
      "step": 2,
      "default": 52
    },
    {
      "type": "range",
      "id": "mobile_button_height",
      "label": "Button height mobile",
      "min": 24,
      "max": 60,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "button_size",
